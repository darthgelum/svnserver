# Copy selected settings to .env. Host paths must be absolute, on local storage.
# Keep live repositories outside file synchronization tools.
MIRROR_DATA=/srv/svn-mirror/data
# Optional existing-copy overlay: directory directly containing repository folders.
# EXISTING_REPOS=/replace/with/existing/svnserver/volume/svnrepo/svn
CONFIG_FILE=./config/repos.json
AUTH_DIR=./auth
CREDENTIALS_FILE=./secrets/source.json
# Set to the mirror host LAN/VPN IP. The default binds only to loopback.
BIND_IP=127.0.0.1
MIRROR_PORT=18080
LIVE_PORT=18081
# Existing SVN logins allowed into /svn-mirror-status/. No ordinary users by default.
STATUS_USERS=svnmirror
SYNC_INTERVAL_SECONDS=30
DISCOVERY_INTERVAL_SECONDS=30
SYNC_TIMEOUT_SECONDS=21600
# Active history transfers have no total-duration cap. Stop/retry idle ones.
SYNC_TRANSFER_TIMEOUT_SECONDS=0
SYNC_IDLE_TIMEOUT_SECONDS=3600
SYNC_PROGRESS_SECONDS=30
SYNC_METADATA_TIMEOUT_SECONDS=120
MAX_SYNC_AGE_SECONDS=300
MAX_LAG_REVISIONS=0
# Reconcile edits to OLD revision properties (e.g. log messages), too.
REVPROP_RESCAN_SECONDS=3600

# Optional separate Apache on the master host, sharing its existing repositories.
MASTER_BIND_IP=127.0.0.1
MASTER_PORT=18082
MASTER_REPOS=/replace/with/repository-parent-directory
MASTER_AUTH_DIR=./auth
MASTER_CONFIG_FILE=./config/master.json

# Optional public HTTPS by IP: compose.master.yaml + compose.https.yaml.
PUBLIC_IP=REPLACE_WITH_PERMANENT_PUBLIC_IPV4
ACME_EMAIL=REPLACE_WITH_EMAIL
TLS_DATA=/srv/svn-tls
TLS_BIND_IP=0.0.0.0
ACME_HTTP_PORT=18083
SVN_HTTPS_PORT=18443
ACME_SERVER=https://acme-v02.api.letsencrypt.org/directory
RENEW_INTERVAL_SECONDS=43200
ACME_RETRY_SECONDS=900
