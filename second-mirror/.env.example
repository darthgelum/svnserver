# Copy to .env. All NAS paths must be absolute and outside Drive ShareSync.
MIRROR_DATA=/volume1/docker/svn-second-mirror-data
CONFIG_FILE=./config/repos.json
AUTH_DIR=./auth
CREDENTIALS_FILE=./secrets/source.json
# Set to the second mirror NAS LAN/VPN IP. A loopback default prevents public exposure.
BIND_IP=127.0.0.1
MIRROR_PORT=18080
LIVE_PORT=18081
SYNC_INTERVAL_SECONDS=30
SYNC_TIMEOUT_SECONDS=21600
MAX_SYNC_AGE_SECONDS=300
MAX_LAG_REVISIONS=0
# Reconcile edits to OLD revision properties (e.g. log messages), too.
REVPROP_RESCAN_SECONDS=3600

# Optional separate Apache on the Belgrade NAS, sharing the EXISTING repos.
MASTER_BIND_IP=127.0.0.1
MASTER_PORT=18082
MASTER_REPOS=/replace/with/host/path/containing/BrassRain
MASTER_AUTH_DIR=./auth
MASTER_CONFIG_FILE=./config/master.json

# Optional public HTTPS by IP: compose.belgrade.yaml + compose.https.yaml.
PUBLIC_IP=REPLACE_WITH_PERMANENT_PUBLIC_IPV4
ACME_EMAIL=REPLACE_WITH_EMAIL
TLS_DATA=/volume1/docker/svn-tls-data
TLS_BIND_IP=0.0.0.0
ACME_HTTP_PORT=18083
SVN_HTTPS_PORT=18443
ACME_SERVER=https://acme-v02.api.letsencrypt.org/directory
RENEW_INTERVAL_SECONDS=43200
ACME_RETRY_SECONDS=900
